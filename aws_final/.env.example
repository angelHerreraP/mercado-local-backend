# Database Configuration
DB_URL=jdbc:mysql://localhost:3307/aws_final
DB_USERNAME=root
DB_PASSWORD=root

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# JWT Configuration
JWT_SECRET_KEY=your_very_long_secret_key_for_jwt_signing_algorithm_security
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8081
